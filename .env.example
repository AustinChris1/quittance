# Partner JWT from https://partners.near-intents.org/home. Needed only for Explorer search,
# which resolves a transaction hash to a deposit address. Reading swap status needs no key.
QUITTANCE_PARTNER_JWT=

# 1Click key. Optional: it sets the quote fee schedule and the authenticated rate limit.
QUITTANCE_ONECLICK_KEY=

# Overrides, defaults shown.
# QUITTANCE_ONECLICK_BASE=https://1click.chaindefuser.com
# QUITTANCE_NEAR_RPC=https://rpc.mainnet.fastnear.com
# QUITTANCE_WEBHOOK_URL=
# QUITTANCE_WEBHOOK_SECRET=

# Browser alerts for watched swaps. Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://github.com/AustinChris1/quittance
# Shared with the scheduler that calls /api/watch/run.
WATCH_CRON_SECRET=
# Upstash Redis from the Vercel Marketplace holds the watch list. Without it, development uses a local file.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Paid receipts for agents over x402 (/api/receipt). Leave unset and the route answers 503.
# X402_NEAR_PAY_TO=        NEAR account that receives fees
# X402_NEAR_RELAYER_ACCOUNT=  gas-only relayer that settles NEAR payments (node apps/web/scripts/new-near-account.ts)
# X402_NEAR_RELAYER_KEY=
# X402_NEAR_FACILITATOR_KEY=  a FastNEAR facilitator key, used instead of the relayer when set
# X402_BASE_PAY_TO=        Base address that receives fees, to accept Base too
# X402_PRICE=$0.01
